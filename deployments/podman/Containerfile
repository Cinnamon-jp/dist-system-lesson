FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/node ./cmd/node/main.go
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/tester ./cmd/tester/main.go

FROM alpine:3.21
RUN apk --no-cache add curl bash
WORKDIR /app
COPY --from=builder /app/node /app/node
COPY --from=builder /app/tester /app/tester

EXPOSE 8000
ENTRYPOINT ["/app/node"]
